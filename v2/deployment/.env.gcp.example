# GCP project and region.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west2
GCP_BILLING_ACCOUNT_ID=000000-000000-000000
ALERT_EMAIL=you@example.com

# Terraform remote state. Create this bucket before the first deploy workflow run.
GCP_TERRAFORM_STATE_BUCKET=your-terraform-state-bucket
GCP_TERRAFORM_STATE_PREFIX=hybrid-search/v2/europe-west2

# GitHub repository allowed to deploy through Workload Identity Federation.
GITHUB_OWNER=your-github-org-or-user
GITHUB_REPO=hybrid-search

# Workload Identity Federation outputs.
GCP_WORKLOAD_IDENTITY_POOL=github
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github/providers/github
GCP_SERVICE_ACCOUNT=github-deploy@your-gcp-project-id.iam.gserviceaccount.com

# Artifact Registry image target used by the manual deploy workflow.
GCP_ARTIFACT_REGISTRY_REPOSITORY=hybrid-search-v2
GCP_API_IMAGE_NAME=api
GCP_API_IMAGE=europe-west2-docker.pkg.dev/your-gcp-project-id/hybrid-search-v2/api:GIT_SHA

# GitHub Actions repository variables.
# Add these in GitHub: Settings -> Secrets and variables -> Actions -> Variables.
GITHUB_VAR_GCP_PROJECT_ID=your-gcp-project-id
GITHUB_VAR_ALERT_EMAIL=you@example.com

# GitHub Actions repository secrets.
# Add these in GitHub: Settings -> Secrets and variables -> Actions -> Secrets.
GITHUB_SECRET_GCP_BILLING_ACCOUNT_ID=000000-000000-000000
GITHUB_SECRET_GCP_TERRAFORM_STATE_BUCKET=your-terraform-state-bucket
GITHUB_SECRET_GCP_WORKLOAD_IDENTITY_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github/providers/github
GITHUB_SECRET_GCP_SERVICE_ACCOUNT=github-deploy@your-gcp-project-id.iam.gserviceaccount.com

# Optional Terraform overrides for the EU live-beta profile.
TF_VAR_api_min_instances=1
TF_VAR_api_max_instances=10
TF_VAR_api_concurrency=16
TF_VAR_api_cpu=1
TF_VAR_api_memory=1Gi
TF_VAR_redis_memory_size_gb=2
TF_VAR_elasticsearch_node_count=2
TF_VAR_elasticsearch_machine_type=e2-standard-4
TF_VAR_elasticsearch_disk_size_gb=150
TF_VAR_elasticsearch_heap_size=8g
TF_VAR_elasticsearch_container_memory=14g
TF_VAR_cache_ttl_seconds=600
TF_VAR_cache_max_entries=50000
TF_VAR_per_client_rate_per_minute=6000
TF_VAR_global_rate_per_minute=6000
