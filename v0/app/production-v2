"""
Hybrid search API over a magazine corpus (info + content indices).

Design constraints (the stance):
  bounded    - every external call has a timeout, every collection has a size bound
  scarce     - the model and the vector index are the dominant costs; both are bounded
  adversarial- every input is validated; every failure has a defined behavior

Run:
  uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2

Environment:
  ES_HOST, ES_PORT, ES_SCHEME, ES_USER, ES_PASSWORD
  REDIS_URL
  EMBEDDING_MODEL, EMBEDDING_MAX_TOKENS
  REQUEST_TIMEOUT_MS, ES_TIMEOUT_MS, REDIS_TIMEOUT_MS
  CACHE_TTL_SECONDS, CACHE_MAX_KEY_LEN, MAX_QUERY_LEN, MAX_FROM
"""

from __future__ import annotations

import asyncio
import hashlib
import json
import logging
import os
import time
from contextlib import asynccontextmanager
from typing import Optional

import redis.asyncio as redis_async
import uvicorn
from elasticsearch import AsyncElasticsearch
from fastapi import FastAPI, HTTPException, Request
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field, field_validator
from sentence_transformers import SentenceTransformer

# --------------------------------------------------------------------------- #
# Configuration (externalized, validated at startup)
# --------------------------------------------------------------------------- #

ES_HOST = os.environ["ES_HOST"]
ES_PORT = int(os.environ.get("ES_PORT", "9200"))
ES_SCHEME = os.environ.get("ES_SCHEME", "https")
ES_USER = os.environ["ES_USER"]
ES_PASSWORD = os.environ["ES_PASSWORD"]

REDIS_URL = os.environ["REDIS_URL"]

EMBEDDING_MODEL_NAME = os.environ.get("EMBEDDING_MODEL", "all-MiniLM-L6-v2")
EMBEDDING_MAX_TOKENS = int(os.environ.get("EMBEDDING_MAX_TOKENS", "128"))

REQUEST_TIMEOUT_MS = int(os.environ.get("REQUEST_TIMEOUT_MS", "2000"))
ES_TIMEOUT_MS = int(os.environ.get("ES_TIMEOUT_MS", "800"))
REDIS_TIMEOUT_MS = int(os.environ.get("REDIS_TIMEOUT_MS", "100"))

CACHE_TTL_SECONDS = int(os.environ.get("CACHE_TTL_SECONDS", "300"))
CACHE_MAX_KEY_LEN = int(os.environ.get("CACHE_MAX_KEY_LEN", "256"))

MAX_QUERY_LEN = int(os.environ.get("MAX_QUERY_LEN", "512"))
MAX_FROM = int(os.environ.get("MAX_FROM", "1000"))

MAGAZINE_INFO_INDEX = "magazine_info"
MAGAZINE_CONTENT_INDEX = "magazine_content"

VECTOR_FIELD = "content_vector"
VECTOR_DIMS = 384  # all-MiniLM-L6-v2

log = logging.getLogger("hybrid_search")

# --------------------------------------------------------------------------- #
# Resources (initialized once, shared across workers if possible)
# --------------------------------------------------------------------------- #

es: AsyncElasticsearch | None = None
redis: redis_async.Redis | None = None
model: SentenceTransformer | None = None
# Thread pool for CPU-bound model work. Bounded, so the event loop can't
# be flooded with more encode() calls than we can actually run.
_embedding_semaphore: asyncio.Semaphore | None = None
_EMBEDDING_CONCURRENCY = 2  # per worker; tune to core count


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Validate dependencies at startup. Fail fast, not at first request."""
    global es, redis, model, _embedding_semaphore

    log.info("startup: connecting to elasticsearch")
    es = AsyncElasticsearch(
        hosts=[f"{ES_SCHEME}://{ES_HOST}:{ES_PORT}"],
        basic_auth=(ES_USER, ES_PASSWORD),
        request_timeout=ES_TIMEOUT_MS / 1000,
        max_retries=1,
        retry_on_timeout=False,
        connections_per_node=10,
        http_compress=True,
    )
    try:
        await asyncio.wait_for(es.ping(), timeout=ES_TIMEOUT_MS / 1000)
    except Exception as exc:
        log.error("elasticsearch unreachable at startup: %s", exc)
        raise

    log.info("startup: connecting to redis")
    redis = redis_async.from_url(
        REDIS_URL,
        encoding="utf-8",
        decode_responses=True,
        socket_timeout=REDIS_TIMEOUT_MS / 1000,
        socket_connect_timeout=REDIS_TIMEOUT_MS / 1000,
        max_connections=32,
        health_check_interval=30,
    )
    try:
        await asyncio.wait_for(redis.ping(), timeout=REDIS_TIMEOUT_MS / 1000)
    except Exception as exc:
        log.error("redis unreachable at startup: %s", exc)
        raise

    log.info("startup: loading embedding model %s", EMBEDDING_MODEL_NAME)
    model = SentenceTransformer(EMBEDDING_MODEL_NAME)
    model.max_seq_length = EMBEDDING_MAX_TOKENS
    _embedding_semaphore = asyncio.Semaphore(_EMBEDDING_CONCURRENCY)

    log.info("startup: ready")
    yield

    log.info("shutdown: closing connections")
    if es is not None:
        await es.close()
    if redis is not None:
        await redis.aclose()


app = FastAPI(lifespan=lifespan, title="Hybrid Magazine Search")


# --------------------------------------------------------------------------- #
# Request / response models (validated, bounded)
# --------------------------------------------------------------------------- #

class SearchQuery(BaseModel):
    query: str = Field(..., min_length=1, max_length=MAX_QUERY_LEN)
    top_k: int = Field(default=10, ge=1, le=50)
    from_: int = Field(default=0, ge=0, le=MAX_FROM)
    category: Optional[str] = Field(default=None, max_length=64)

    model_config = {"extra": "forbid", "str_strip_whitespace": True}

    @field_validator("query")
    @classmethod
    def query_no_control_chars(cls, v: str) -> str:
        if any(ord(c) < 0x20 and c not in "\t\n" for c in v):
            raise ValueError("query contains control characters")
        return v

    @field_validator("category")
    @classmethod
    def category_no_control_chars(cls, v: Optional[str]) -> Optional[str]:
        if v is None:
            return None
        if any(ord(c) < 0x20 for c in v):
            raise ValueError("category contains control characters")
        return v


class SearchResult(BaseModel):
    id: str
    title: str
    author: str
    content: str
    score: float
    category: str
    updated_at: str


class SearchResponse(BaseModel):
    results: list[SearchResult]
    cached: bool
    took_ms: int


# --------------------------------------------------------------------------- #
# Helpers
# --------------------------------------------------------------------------- #

def _make_cache_key(query: str, top_k: int, from_: int, category: Optional[str]) -> str:
    """
    Cache key is a hash of *all* inputs that affect the result.
    Bounded length. Namespaced. Includes category.
    """
    raw = json.dumps(
        {
            "q": query.strip().lower(),  # normalize case + whitespace
            "k": top_k,
            "f": from_,
            "c": (category or "").lower(),
            "v": 1,  # cache schema version; bump when response shape changes
        },
        sort_keys=True,
        separators=(",", ":"),
    )
    digest = hashlib.sha256(raw.encode("utf-8")).hexdigest()
    return f"search:v1:{digest}"


async def _embed(text: str) -> list[float]:
    """
    Embed text off the event loop.
    Bounded by a semaphore so we don't launch more encode() calls than cores.
    """
    assert model is not None and _embedding_semaphore is not None
    async with _embedding_semaphore:
        # run_in_executor: CPU-bound work off the loop
        loop = asyncio.get_running_loop()
        vector = await loop.run_in_executor(None, model.encode, text)
    return vector.tolist()


async def _cached_get(cache_key: str) -> Optional[list[SearchResult]]:
    """Cache read. Failure is non-fatal."""
    if redis is None:
        return None
    try:
        raw = await asyncio.wait_for(
            redis.get(cache_key), timeout=REDIS_TIMEOUT_MS / 1000
        )
        if not raw:
            return None
        parsed = json.loads(raw)
        return [SearchResult(**item) for item in parsed]
    except Exception as exc:
        log.warning("cache read failed (serving fresh): %s", exc)
        return None


async def _cached_set(cache_key: str, results: list[SearchResult]) -> None:
    """Cache write. Failure is non-fatal."""
    if redis is None:
        return
    try:
        payload = json.dumps([r.model_dump() for r in results])
        # Bound the payload: refuse to cache absurdly large results.
        if len(payload) > 64_000:
            log.warning("cache payload too large, skipping")
            return
        await asyncio.wait_for(
            redis.set(cache_key, payload, ex=CACHE_TTL_SECONDS),
            timeout=REDIS_TIMEOUT_MS / 1000,
        )
    except Exception as exc:
        log.warning("cache write failed (non-fatal): %s", exc)


async def _record_stat(query: str) -> None:
    """Bounded stats counter. Key is hashed, not raw."""
    if redis is None:
        return
    try:
        digest = hashlib.sha256(query.strip().lower().encode()).hexdigest()[:16]
        await asyncio.wait_for(
            redis.incr(f"stats:v1:{digest}"),
            timeout=REDIS_TIMEOUT_MS / 1000,
        )
    except Exception as exc:
        log.debug("stat write failed (non-fatal): %s", exc)


# --------------------------------------------------------------------------- #
# Search primitives
# --------------------------------------------------------------------------- #

def _category_clause(category: Optional[str]) -> list[dict]:
    if not category:
        return []
    return [{"term": {"category.keyword": category}}]


async def keyword_search(
    query: str, top_k: int, from_: int, category: Optional[str]
) -> list[SearchResult]:
    """
    BM25 keyword search over title^2, author, content.
    Bounded: explicit _source filtering, explicit timeout, no unbounded from_.
    """
    assert es is not None
    body = {
        "size": top_k,
        "from": from_,
        "_source": ["id", "title", "author", "category", "updated_at"],
        "query": {
            "bool": {
                "must": [
                    {
                        "multi_match": {
                            "query": query,
                            "fields": ["title^2", "author", "content"],
                            "type": "best_fields",
                            "fuzziness": "AUTO",
                            "prefix_length": 2,
                            "minimum_should_match": "75%",
                        }
                    }
                ],
                "filter": _category_clause(category),
            }
        },
        "highlight": {
            "fields": {
                "title": {},
                "author": {},
                "content": {"fragment_size": 150, "number_of_fragments": 1},
            }
        },
    }
    resp = await asyncio.wait_for(
        es.search(index=MAGAZINE_INFO_INDEX, body=body),
        timeout=ES_TIMEOUT_MS / 1000,
    )
    return _to_results(resp, id_source="_id")


async def vector_search(
    query: str, top_k: int, from_: int, category: Optional[str]
) -> list[SearchResult]:
    """
    Native ES kNN. Requires the content index to have a dense_vector field
    named `content_vector` with `index: true` and the right similarity.

    No linear scan. num_candidates bounds the HNSW exploration.
    """
    assert es is not None
    query_vector = await _embed(query)
    num_candidates = min(max(top_k * 10, 100), 500)

    knn = {
        "field": VECTOR_FIELD,
        "query_vector": query_vector,
        "k": top_k,
        "num_candidates": num_candidates,
        "filter": _category_clause(category),
    }
    body = {
        "knn": knn,
        "size": top_k,
        "from": from_,
        "_source": ["id", "title", "author", "category", "updated_at"],
    }
    resp = await asyncio.wait_for(
        es.search(index=MAGAZINE_CONTENT_INDEX, body=body),
        timeout=ES_TIMEOUT_MS / 1000,
    )
    return _to_results(resp, id_source="id")


def _to_results(resp: dict, id_source: str) -> list[SearchResult]:
    """
    Convert an ES response into SearchResult objects.
    Uses the *same* id source on both paths when `_id` and `source.id` agree;
    here we always use the document's own `id` field for consistency.
    """
    out: list[SearchResult] = []
    for hit in resp.get("hits", {}).get("hits", []):
        src = hit.get("_source", {})
        hl = hit.get("highlight", {})

        def pick(field: str, fallback: str = "") -> str:
            if field in hl and hl[field]:
                return hl[field][0]
            val = src.get(field, fallback)
            return "" if val is None else str(val)

        content_raw = src.get("content") or ""
        content_snippet = content_raw[:150] + ("..." if len(content_raw) > 150 else "")

        out.append(
            SearchResult(
                id=str(src.get("id", hit.get("_id", ""))),
                title=pick("title"),
                author=pick("author"),
                content=hl["content"][0] if hl.get("content") else content_snippet,
                score=float(hit.get("_score", 0.0)),
                category=str(src.get("category", "")),
                updated_at=str(src.get("updated_at", "")),
            )
        )
    return out


# --------------------------------------------------------------------------- #
# Fusion (RRF: robust to score-scale mismatch, no magic weights)
# --------------------------------------------------------------------------- #

def _rrf_merge(
    keyword: list[SearchResult],
    vector: list[SearchResult],
    top_k: int,
    k: int = 60,
) -> list[SearchResult]:
    """
    Reciprocal Rank Fusion.
    RRF is chosen over weighted-score fusion because:
      - BM25 scores and cosine scores are not on the same scale
      - RRF needs no normalization and no hand-tuned weights
      - RRF is robust to either path returning few results
    """
    scores: dict[str, float] = {}
    by_id: dict[str, SearchResult] = {}

    for rank, r in enumerate(keyword, start=1):
        scores[r.id] = scores.get(r.id, 0.0) + 1.0 / (k + rank)
        by_id.setdefault(r.id, r)
    for rank, r in enumerate(vector, start=1):
        scores[r.id] = scores.get(r.id, 0.0) + 1.0 / (k + rank)
        by_id.setdefault(r.id, r)

    ordered = sorted(scores.items(), key=lambda kv: kv[1], reverse=True)[:top_k]
    merged: list[SearchResult] = []
    for doc_id, rrf_score in ordered:
        r = by_id[doc_id]
        r.score = rrf_score
        merged.append(r)
    return merged


# --------------------------------------------------------------------------- #
# Endpoint
# --------------------------------------------------------------------------- #

@app.post("/search", response_model=SearchResponse)
async def search(search_query: SearchQuery, request: Request) -> SearchResponse:
    started = time.perf_counter()
    query = search_query.query
    top_k = search_query.top_k
    from_ = search_query.from_
    category = search_query.category

    cache_key = _make_cache_key(query, top_k, from_, category)

    # 1. cache read (non-fatal)
    cached = await _cached_get(cache_key)
    if cached is not None:
        took_ms = int((time.perf_counter() - started) * 1000)
        # fire-and-forget stats; no await on the response path
        asyncio.create_task(_record_stat(query))
        return SearchResponse(results=cached, cached=True, took_ms=took_ms)

    # 2. run both searches concurrently, but tolerate one path failing
    results = await asyncio.gather(
        keyword_search(query, top_k, from_, category),
        vector_search(query, top_k, from_, category),
        return_exceptions=True,
    )
    keyword_results = results[0] if not isinstance(results[0], Exception) else []
    vector_results = results[1] if not isinstance(results[1], Exception) else []

    # If both failed, that's a real 503 — not a 500 with a stack trace.
    if not keyword_results and not vector_results:
        log.error("both search paths failed: %r", results)
        raise HTTPException(status_code=503, detail="search backend unavailable")

    merged = _rrf_merge(keyword_results, vector_results, top_k)

    # 3. cache write (non-fatal)
    await _cached_set(cache_key, merged)

    # 4. stats (fire and forget)
    asyncio.create_task(_record_stat(query))

    took_ms = int((time.perf_counter() - started) * 1000)
    return SearchResponse(results=merged, cached=False, took_ms=took_ms)


# --------------------------------------------------------------------------- #
# Health / readiness
# --------------------------------------------------------------------------- #

@app.get("/healthz")
async def healthz() -> dict:
    """Liveness: process is up."""
    return {"status": "ok"}


@app.get("/readyz")
async def readyz() -> JSONResponse:
    """Readiness: dependencies reachable."""
    checks = {"es": False, "redis": False}
    if es is not None:
        try:
            checks["es"] = bool(
                await asyncio.wait_for(es.ping(), timeout=ES_TIMEOUT_MS / 1000)
            )
        except Exception:
            checks["es"] = False
    if redis is not None:
        try:
            checks["redis"] = bool(
                await asyncio.wait_for(redis.ping(), timeout=REDIS_TIMEOUT_MS / 1000)
            )
        except Exception:
            checks["redis"] = False
    ready = checks["es"]  # redis is optional
    return JSONResponse(
        status_code=200 if ready else 503,
        content={"ready": ready, "checks": checks},
    )


# --------------------------------------------------------------------------- #
# Error handling — no internal detail leaked to the client
# --------------------------------------------------------------------------- #

@app.exception_handler(Exception)
async def unhandled_exception_handler(request: Request, exc: Exception) -> JSONResponse:
    log.exception("unhandled error on %s %s", request.method, request.url.path)
    return JSONResponse(status_code=500, content={"detail": "internal error"})


if __name__ == "__main__":
    uvicorn.run(
        "app:app",
        host="127.0.0.1",
        port=8000,
        workers=int(os.environ.get("WORKERS", "2")),
        limit_concurrency=int(os.environ.get("LIMIT_CONCURRENCY", "200")),
        timeout_keep_alive=5,
        limit_max_requests=int(os.environ.get("LIMIT_MAX_REQUESTS", "10000")),
        log_level="info",
    )
